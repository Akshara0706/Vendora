{
  "name": "vendora",
  "version": "1.0.0",
  "description": "Vendora - A Multi-Vendor Local Marketplace",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
